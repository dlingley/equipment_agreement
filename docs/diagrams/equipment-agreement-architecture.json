  "cards": [
    {
      "dot": "cyan",
      "title": "Public Kiosk & Self Check-in",
      "items": [
        "Dedicated kiosk interface with sanitized header hiding administrative tools from patrons",
        "12-hour session persistence powered by session.js visibility handlers and keepalive.php pings",
        "Collects patron Purdue ID/username and digital signature agreement"
      ]
    },
    {
      "dot": "emerald",
      "title": "Alma Cloud Integration & Messaging",
      "items": [
        "Queries Alma User REST API to verify patron active status and existing agreement notes",
        "Appends standardized equipment agreement note to patron record upon first completion",
        "Dispatches automated email confirmation receipts to patron campus inboxes"
      ]
    },
    {
      "dot": "rose",
      "title": "Enterprise SAML SSO & RBAC",
      "items": [
        "Integrated with central Purdue Auth Hub (/alma/auth/auth_guard.php) via BoilerKey SAML",
        "Three-tier role-based access control (superadmin, admin, user) defined in allowed_users.txt",
        "Super Admin User Access Manager (users.php) for live staff provisioning and role updates"
      ]
    }
  ]
